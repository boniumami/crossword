{
  "name": "poetry-fill-game",
  "version": "1.0.0",
  "private": true,
  "description": "古诗词填写小游戏",
  "scripts": {
    "postinstall": "npm install --prefix web",
    "server": "node server/index.js",
    "web": "npm run dev --prefix web",
    "dev": "concurrently -k \"npm run server\" \"npm run web\"",
    "build": "npm run build --prefix web",
    "start": "node server/index.js",
    "test": "npm test --prefix web"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
